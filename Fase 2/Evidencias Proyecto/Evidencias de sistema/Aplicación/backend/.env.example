# Copia este archivo como .env (en esta misma carpeta). El archivo .env NO se
# sube a GitHub.

# IA generativa (carta de reclamo y resumen ejecutivo).
# Se intenta primero con la IA principal; si no tiene clave, se agotó su
# cuota o saldo, o no responde, redacta la de respaldo; si tampoco, se usa la
# plantilla fija. IA_PRINCIPAL: claude (la que usa el equipo) o gemini.
IA_PRINCIPAL=claude

# Gemini. Clave en https://aistudio.google.com. El nivel gratuito no está
# disponible en todas las cuentas ni países: si AI Studio pide configurar la
# facturación, la clave no tendrá cuota y LogiSLA usará el respaldo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=25

# Claude (IA principal del equipo). Clave en https://platform.claude.com
# Usa créditos prepagados, con la recarga automática desactivada.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_TIMEOUT_S=30

# Base de datos. Sin esta línea, iniciar.bat usa su PostgreSQL integrado
# (C:\LogiSLA\pgsql). Úsala solo para conectar otro PostgreSQL, por ejemplo
# el de "docker compose up -d" en esta carpeta:
# DATABASE_URL=postgresql+psycopg2://logisla:logisla@localhost:5432/logisla

MAX_UPLOAD_SIZE_MB=25
